exports[`Render test NavBar 1`] = `
<div
  className=""
>
  <div
    className="layouts-margin-bottom-2px"
  >
    <nav
      className="uk-navbar uk-section-muted margin-xsmall"
    >
      <div
        className="uk-navbar-left"
      >
        <span
          className="uk-navbar-toggle"
          uk-toggle="target: #offcanvas-overlay"
        >
          <a
            className="
      
      atoms-button-icon
      
    "
            href=""
            onClick={[Function]}
            type="button"
          >
            <span
              uk-icon="menu"
            />
          </a>
        </span>
        <div
          className=" atoms-divider-vertical"
        />
        <div
          className=" uk-text-middle"
        >
          hello
        </div>
      </div>
    </nav>
  </div>
</div>
`;
